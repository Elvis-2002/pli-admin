# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# Firebase Web App config (Firebase console → Project settings → General)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — cloud name and API key are not secret and are safe in the
# client bundle. The API SECRET is never put here — it only lives in the
# Cloud Function config (see functions/README or main project README).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=
